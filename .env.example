# Priority1 API key. Leave blank to run in demo mode with realistic sample rates.
# Never commit a real key. The browser never receives this value.
P1_API_KEY=

# Sandbox (default):
P1_BASE_URL=https://dev-api.priority1.com
# Production:
# P1_BASE_URL=https://api.priority1.com

# Force demo rates even when P1_API_KEY is set (true/false).
# When the key is empty, demo mode turns on by itself.
P1_MOCK=false
