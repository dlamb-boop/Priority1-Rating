# Copy to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste these keys into the app's Secrets box.
# Do not commit secrets.toml.

# Leave blank for demo rates. Never commit a real key. The key is never shown in the UI.
P1_API_KEY = ""

# Sandbox (default). Production: https://api.priority1.com
P1_BASE_URL = "https://dev-api.priority1.com"

# Force demo rates even when a key is set (true/false).
P1_MOCK = "false"
